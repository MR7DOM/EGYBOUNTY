# --- Required ---
DATABASE_URL=postgres://egybounty:CHANGE_ME@localhost:5432/egybounty
JWT_SECRET=put-a-random-string-of-at-least-32-characters-here
BASE_URL=http://localhost:3000
# First admin account (created on first start; 2FA is forced at first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisLongPassword123
# --- Money ---
COMMISSION_PCT=15
MIN_WITHDRAWAL=100
PLATFORM_BANK_INFO=Bank: ...  |  Account name: ...  |  IBAN: ...
# --- Storage (keep on disks inside Egypt) ---
UPLOAD_DIR=./data/uploads
PRIVATE_DIR=./data/private
# --- Email (leave SMTP_HOST empty in development: emails print to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EgyBounty <no-reply@your-domain.eg>
# --- Misc ---
PORT=3000
NODE_ENV=production
# development only: skip email verification
DEV_AUTO_VERIFY=false
